<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: ilaç verisi Google bulut yedeğine girmez (gizlilik politikası:
     "veriler cihazdan çıkmaz"). Kullanıcının kendi başlattığı cihazdan cihaza
     aktarım açık kalır; telefon değiştirince ilaç listesi kaybolmasın. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
